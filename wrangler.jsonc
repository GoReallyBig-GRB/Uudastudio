{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uuda-studio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "uudastudio.goreallybig.com/*",
      "zone_name": "goreallybig.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "JOB_ROOM", "class_name": "JobRoom" },
      { "name": "JOB_REGISTRY", "class_name": "JobRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JobRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["JobRegistry"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api"]
  }
}
