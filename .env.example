# ---------------------------------------------------------------------------
# Uuda Studio configuration. Copy to .env for local work. Never commit .env.
# On Cloud Run, secrets come from Secret Manager (see the deploy workflow); plain settings are environment variables.
# ---------------------------------------------------------------------------

# Gemini key used for voiceovers when a user has not added their own key
GEMINI_API_KEY=""

# Public address of the app (used for links and OAuth callbacks)
APP_URL="http://localhost:3000"

# Firebase project (verifies Google sign-in tokens on the server). Defaults to the project in firebase-applet-config.json.
FIREBASE_PROJECT_ID=""
# Set true to also reject tokens that were revoked (needs server credentials; Cloud Run has them automatically)
FIREBASE_CHECK_REVOKED="false"

# Admin: the super-admin email, plus optional extra admins (comma separated)
SUPER_ADMIN_EMAIL="killdasmoke@gmail.com"
ADMIN_EMAILS=""

# Email for admin codes and ticket notices (Gmail app password, not the account password)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Freesound
FREESOUND_API_KEY=""
FREESOUND_CLIENT_ID=""
FREESOUND_CLIENT_SECRET=""
FREESOUND_ENABLED="false"

# Security headers: set true after sign-in, audio and plugins are confirmed to work under the policy
CSP_ENFORCE="false"

# FFmpeg audio jobs (denoise, MP3 export on the server). Off by default; the app does these in the browser.
ENABLE_AUDIO_JOBS="false"

# Where the local development database file lives (not used in production)
# UUDA_DATA_DIR="./data"
