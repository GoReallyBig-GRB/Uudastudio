{
  "name": "uuda-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist-server/server.js",
    "build:all": "npm run build && npm run build:server",
    "start:prod": "NODE_ENV=production node dist-server/server.js",
    "preview": "vite preview",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.16",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
