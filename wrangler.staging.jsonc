{
  // A separate copy of the app for testing the real architecture (Workers, Durable Objects, WebSockets) at uudatest.goreallybig.com (and a workers.dev fallback).
  // It never touches the production Worker or the custom domain.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uudatest",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "routes": [{ "pattern": "uudatest.goreallybig.com", "custom_domain": true }],
  // The Firebase project the browser signs in with. A public id, not a secret.
  // Sign-in on this Worker also needs the AUTH_DB (D1) binding and the SESSION_SECRET secret; until both exist it stays off.
  "vars": { "FIREBASE_PROJECT_ID": "gen-lang-client-0557048278" },
  "durable_objects": {
    "bindings": [
      { "name": "JOB_ROOM", "class_name": "JobRoom" },
      { "name": "JOB_REGISTRY", "class_name": "JobRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JobRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["JobRegistry"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api"]
  }
}
